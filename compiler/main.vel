Token(kind, text) {}

var parse_tokens = []
var parse_cursor = 0

is_digit(ch) => ch >= "0" && ch <= "9"
is_lower(ch) => ch >= "a" && ch <= "z"
is_upper(ch) => ch >= "A" && ch <= "Z"
is_letter(ch) => is_lower(ch) || is_upper(ch)
is_ident_start(ch) => ch == "_" || is_letter(ch)
is_ident_continue(ch) => is_ident_start(ch) || is_digit(ch)

slice(text, start, end) {
    var output = ""
    for index in range(start, end) {
        output = output + text[index]
    }
    return output
}

keyword_kind(text) {
    if text == "true" { return "true" }
    if text == "false" { return "false" }
    if text == "null" { return "null" }
    if text == "use" { return "use" }
    if text == "pub" { return "pub" }
    if text == "var" { return "var" }
    if text == "if" { return "if" }
    if text == "else" { return "else" }
    if text == "for" { return "for" }
    if text == "in" { return "in" }
    if text == "when" { return "when" }
    if text == "return" { return "return" }
    if text == "object" { return "object" }
    if text == "extend" { return "extend" }
    if text == "shape" { return "shape" }
    if text == "async" { return "async" }
    if text == "await" { return "await" }
    if text == "try" { return "try" }
    if text == "throw" { return "throw" }
    return null
}

decode_escape(ch) {
    if ch == "n" { return "\n" }
    if ch == "r" { return "\r" }
    if ch == "t" { return "\t" }
    if ch == "0" { return "\0" }
    if ch == "\\" { return "\\" }
    if ch == "\"" { return "\"" }
    if ch == "$" { return "$" }
    return ch
}

lex(source) {
    var result = []
    var index = 0
    length = len(source)

    for step in range(length) {
        if step == index {
            ch = source[index]
            next = if index + 1 < length { source[index + 1] } else { "" }

            if ch == " " || ch == "\t" || ch == "\r" {
                index = index + 1
            } else if ch == "\n" {
                push(result, Token("sep", "\n"))
                index = index + 1
            } else if ch == "/" && next == "/" {
                var end = length
                var found = false
                for scan in range(index + 2, length) {
                    if !found && source[scan] == "\n" {
                        end = scan
                        found = true
                    }
                }
                index = end
            } else if is_digit(ch) {
                var end = index + 1
                var done = false
                var dot = false
                for scan in range(index + 1, length) {
                    if !done {
                        current = source[scan]
                        if is_digit(current) {
                            end = scan + 1
                        } else if current == "." && !dot && scan + 1 < length && is_digit(source[scan + 1]) {
                            dot = true
                            end = scan + 1
                        } else {
                            done = true
                        }
                    }
                }
                text = slice(source, index, end)
                kind = if dot { "float" } else { "int" }
                push(result, Token(kind, text))
                index = end
            } else if ch == "\"" {
                var value = ""
                var end = length
                var done = false
                var escaped = false
                for scan in range(index + 1, length) {
                    if !done {
                        current = source[scan]
                        if escaped {
                            value = value + decode_escape(current)
                            escaped = false
                        } else if current == "\\" {
                            escaped = true
                        } else if current == "\"" {
                            end = scan + 1
                            done = true
                        } else {
                            value = value + current
                        }
                    }
                }
                assert(done, "unterminated string literal")
                push(result, Token("string", value))
                index = end
            } else if is_ident_start(ch) {
                var end = index + 1
                var done = false
                for scan in range(index + 1, length) {
                    if !done {
                        current = source[scan]
                        if is_ident_continue(current) {
                            end = scan + 1
                        } else {
                            done = true
                        }
                    }
                }
                text = slice(source, index, end)
                keyword = keyword_kind(text)
                if keyword != null {
                    push(result, Token(keyword, text))
                } else if is_upper(ch) {
                    push(result, Token("data-ident", text))
                } else {
                    push(result, Token("ident", text))
                }
                index = end
            } else {
                pair = ch + next
                if pair == "==" || pair == "!=" || pair == "<=" || pair == ">=" || pair == "&&" || pair == "||" || pair == "?." || pair == "?:" || pair == "=>" || pair == "->" {
                    push(result, Token(pair, pair))
                    index = index + 2
                } else {
                    valid = ch == "=" || ch == "+" || ch == "-" || ch == "*" || ch == "/" || ch == "%" || ch == "<" || ch == ">" || ch == "!" || ch == "." || ch == "," || ch == ":" || ch == ";" || ch == "?" || ch == "(" || ch == ")" || ch == "{" || ch == "}" || ch == "[" || ch == "]"
                    assert(valid, "unexpected character in source")
                    if ch == ";" {
                        push(result, Token("sep", ch))
                    } else {
                        push(result, Token(ch, ch))
                    }
                    index = index + 1
                }
            }
        }
    }

    push(result, Token("eof", ""))
    return result
}

quote(value) {
    var output = "\""
    for ch in value {
        if ch == "\n" {
            output = output + "\\n"
        } else if ch == "\r" {
            output = output + "\\r"
        } else if ch == "\t" {
            output = output + "\\t"
        } else if ch == "\0" {
            output = output + "\\0"
        } else if ch == "\"" {
            output = output + "\\\""
        } else if ch == "\\" {
            output = output + "\\\\"
        } else {
            output = output + ch
        }
    }
    return output + "\""
}

current_kind() {
    if parse_cursor >= len(parse_tokens) { return "eof" }
    return parse_tokens[parse_cursor].kind
}

current_text() {
    if parse_cursor >= len(parse_tokens) { return "" }
    return parse_tokens[parse_cursor].text
}

kind_at(index) {
    if index < 0 || index >= len(parse_tokens) { return "eof" }
    return parse_tokens[index].kind
}

at(kind) => current_kind() == kind

eat(kind) {
    if at(kind) {
        parse_cursor = parse_cursor + 1
        return true
    }
    return false
}

expect(kind) {
    assert(at(kind), "unexpected token")
    text = current_text()
    parse_cursor = parse_cursor + 1
    return text
}

consume_separators() {
    for _ in range(len(parse_tokens)) {
        if at("sep") {
            parse_cursor = parse_cursor + 1
        }
    }
}

take_name() {
    assert(at("ident") || at("data-ident"), "expected name")
    text = current_text()
    parse_cursor = parse_cursor + 1
    return text
}

matching_paren(start) {
    var depth = 0
    var result = -1
    for index in range(start, len(parse_tokens)) {
        if result == -1 {
            kind = kind_at(index)
            if kind == "(" {
                depth = depth + 1
            } else if kind == ")" {
                depth = depth - 1
                if depth == 0 { result = index }
            }
        }
    }
    return result
}

looks_like_function_decl() {
    if !at("ident") || kind_at(parse_cursor + 1) != "(" { return false }
    close = matching_paren(parse_cursor + 1)
    if close < 0 { return false }
    next = kind_at(close + 1)
    return next == "=>" || next == "{"
}

looks_like_data_decl() {
    if !at("data-ident") || kind_at(parse_cursor + 1) != "(" { return false }
    close = matching_paren(parse_cursor + 1)
    if close < 0 { return false }
    return kind_at(close + 1) == "{"
}

optional_string(value) {
    if value == null { return "(none)" }
    return "(some " + quote(value) + ")"
}

parse_type_name() {
    name = take_name()
    if eat("?") { return name + "?" }
    return name
}

parse_params() {
    expect("(")
    consume_separators()
    var output = "(params"
    var done = false
    for _ in range(len(parse_tokens)) {
        if !done {
            if at(")") {
                done = true
            } else {
                name = take_name()
                var type_name = null
                if eat(":") { type_name = parse_type_name() }
                output = output + " (param " + quote(name) + " " + optional_string(type_name) + ")"
                consume_separators()
                if eat(",") {
                    consume_separators()
                } else {
                    done = true
                }
            }
        }
    }
    expect(")")
    return output + ")"
}

parse_program() {
    consume_separators()
    var output = "(program"
    var done = false
    for _ in range(len(parse_tokens)) {
        if !done {
            if at("eof") {
                done = true
            } else {
                output = output + " " + parse_statement()
                if !at("eof") { consume_separators() }
            }
        }
    }
    expect("eof")
    return output + ")"
}

parse_statement() {
    if eat("pub") { return "(pub " + parse_statement() + ")" }
    if eat("use") { return parse_use() }
    if eat("var") { return parse_var() }
    if eat("return") { return parse_return() }
    if eat("for") { return parse_for() }
    if at("if") { return "(expr " + parse_if() + ")" }
    if looks_like_data_decl() { return parse_data() }
    if looks_like_function_decl() { return parse_function() }

    target = parse_expression()
    if eat("=") {
        value = parse_expression()
        return "(assign " + target + " " + value + ")"
    }
    return "(expr " + target + ")"
}

parse_use() {
    var output = "(use " + quote(take_name())
    for _ in range(len(parse_tokens)) {
        if eat(".") { output = output + " " + quote(take_name()) }
    }
    return output + ")"
}

parse_var() {
    name = take_name()
    var type_name = null
    if eat(":") { type_name = parse_type_name() }
    expect("=")
    value = parse_expression()
    return "(var " + quote(name) + " " + optional_string(type_name) + " " + value + ")"
}

parse_return() {
    if at("sep") || at("}") || at("eof") { return "(return (none))" }
    return "(return (some " + parse_expression() + "))"
}

parse_for() {
    name = take_name()
    expect("in")
    iterable = parse_expression()
    body = parse_block()
    return "(for " + quote(name) + " " + iterable + " " + body + ")"
}

parse_function() {
    name = expect("ident")
    params = parse_params()
    if eat("=>") {
        return "(function " + quote(name) + " " + params + " (body-expr " + parse_expression() + "))"
    }
    return "(function " + quote(name) + " " + params + " (body-block " + parse_block() + "))"
}

parse_data() {
    name = expect("data-ident")
    params = parse_params()
    expect("{")
    consume_separators()
    var computed = "(computed"
    var done = false
    for _ in range(len(parse_tokens)) {
        if !done {
            if at("}") {
                done = true
            } else {
                field = take_name()
                assert(eat("=") || eat("=>"), "expected computed field")
                computed = computed + " (field " + quote(field) + " " + parse_expression() + ")"
                if !at("}") { consume_separators() }
            }
        }
    }
    expect("}")
    return "(data " + quote(name) + " " + params + " " + computed + "))"
}

parse_block() {
    expect("{")
    consume_separators()
    var output = "(block"
    var done = false
    for _ in range(len(parse_tokens)) {
        if !done {
            if at("}") {
                done = true
            } else {
                output = output + " " + parse_statement()
                if !at("}") { consume_separators() }
            }
        }
    }
    expect("}")
    return output + ")"
}

parse_if() {
    expect("if")
    condition = parse_expression()
    then_branch = parse_block()
    consume_separators()
    var else_branch = "(none)"
    if eat("else") {
        if at("if") {
            else_branch = "(else-if " + parse_if() + ")"
        } else {
            else_branch = "(else-block " + parse_block() + ")"
        }
    }
    return "(if " + condition + " " + then_branch + " " + else_branch + ")"
}

binary(left, op, right) => "(binary " + op + " " + left + " " + right + ")"

parse_expression() => parse_elvis()

parse_elvis() {
    var expr = parse_or()
    for _ in range(len(parse_tokens)) {
        if eat("?:") { expr = binary(expr, "elvis", parse_or()) }
    }
    return expr
}

parse_or() {
    var expr = parse_and()
    for _ in range(len(parse_tokens)) {
        if eat("||") { expr = binary(expr, "or", parse_and()) }
    }
    return expr
}

parse_and() {
    var expr = parse_equality()
    for _ in range(len(parse_tokens)) {
        if eat("&&") { expr = binary(expr, "and", parse_equality()) }
    }
    return expr
}

parse_equality() {
    var expr = parse_comparison()
    var done = false
    for _ in range(len(parse_tokens)) {
        if !done {
            if eat("==") {
                expr = binary(expr, "equal", parse_comparison())
            } else if eat("!=") {
                expr = binary(expr, "not-equal", parse_comparison())
            } else {
                done = true
            }
        }
    }
    return expr
}

parse_comparison() {
    var expr = parse_additive()
    var done = false
    for _ in range(len(parse_tokens)) {
        if !done {
            if eat("<") {
                expr = binary(expr, "less", parse_additive())
            } else if eat("<=") {
                expr = binary(expr, "less-equal", parse_additive())
            } else if eat(">") {
                expr = binary(expr, "greater", parse_additive())
            } else if eat(">=") {
                expr = binary(expr, "greater-equal", parse_additive())
            } else {
                done = true
            }
        }
    }
    return expr
}

parse_additive() {
    var expr = parse_multiplicative()
    var done = false
    for _ in range(len(parse_tokens)) {
        if !done {
            if eat("+") {
                expr = binary(expr, "add", parse_multiplicative())
            } else if eat("-") {
                expr = binary(expr, "subtract", parse_multiplicative())
            } else {
                done = true
            }
        }
    }
    return expr
}

parse_multiplicative() {
    var expr = parse_unary()
    var done = false
    for _ in range(len(parse_tokens)) {
        if !done {
            if eat("*") {
                expr = binary(expr, "multiply", parse_unary())
            } else if eat("/") {
                expr = binary(expr, "divide", parse_unary())
            } else if eat("%") {
                expr = binary(expr, "remainder", parse_unary())
            } else {
                done = true
            }
        }
    }
    return expr
}

parse_unary() {
    if eat("-") { return "(unary negate " + parse_unary() + ")" }
    if eat("!") { return "(unary not " + parse_unary() + ")" }
    return parse_postfix()
}

parse_postfix() {
    var expr = parse_primary()
    var done = false
    for _ in range(len(parse_tokens)) {
        if !done {
            if eat("(") {
                consume_separators()
                var args = "(args"
                var args_done = false
                for _ in range(len(parse_tokens)) {
                    if !args_done {
                        if at(")") {
                            args_done = true
                        } else {
                            args = args + " " + parse_expression()
                            consume_separators()
                            if eat(",") {
                                consume_separators()
                            } else {
                                args_done = true
                            }
                        }
                    }
                }
                expect(")")
                expr = "(call " + expr + " " + args + "))"
            } else if eat(".") {
                expr = "(member " + expr + " " + quote(take_name()) + " false)"
            } else if eat("?.") {
                expr = "(member " + expr + " " + quote(take_name()) + " true)"
            } else if eat("[") {
                index = parse_expression()
                expect("]")
                expr = "(index " + expr + " " + index + ")"
            } else {
                done = true
            }
        }
    }
    return expr
}

parse_primary() {
    if at("int") {
        value = current_text()
        parse_cursor = parse_cursor + 1
        return "(int " + value + ")"
    }
    if at("float") {
        value = current_text()
        parse_cursor = parse_cursor + 1
        return "(float " + value + ")"
    }
    if at("string") {
        value = current_text()
        parse_cursor = parse_cursor + 1
        return "(string " + quote(value) + ")"
    }
    if eat("true") { return "(bool true)" }
    if eat("false") { return "(bool false)" }
    if eat("null") { return "null" }
    if at("ident") || at("data-ident") {
        name = take_name()
        return "(ident " + quote(name) + ")"
    }
    if eat("(") {
        expr = parse_expression()
        expect(")")
        return expr
    }
    if eat("[") {
        var output = "(list"
        consume_separators()
        var done = false
        for _ in range(len(parse_tokens)) {
            if !done {
                if at("]") {
                    done = true
                } else {
                    output = output + " " + parse_expression()
                    consume_separators()
                    if eat(",") {
                        consume_separators()
                    } else {
                        done = true
                    }
                }
            }
        }
        expect("]")
        return output + ")"
    }
    if at("if") { return parse_if() }
    assert(false, "expected expression")
    return "null"
}

compile(source) {
    parse_tokens = lex(source)
    parse_cursor = 0
    return "VELRA-AST-1\n" + parse_program()
}
