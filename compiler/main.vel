Token(kind, text) {}

var parse_tokens = []
var parse_cursor = 0

is_ident_start(ch) => ch == "_" || ch.is_letter()
is_ident_continue(ch) => ch == "_" || ch.is_alphanumeric()

KEYWORDS = {
    "true": "true", "false": "false", "null": "null", "use": "use", "pub": "pub",
    "var": "var", "if": "if", "else": "else", "for": "for", "while": "while",
    "break": "break", "continue": "continue", "in": "in", "when": "when",
    "return": "return", "require": "require", "enum": "enum", "object": "object",
    "extend": "extend", "shape": "shape", "async": "async", "await": "await",
    "try": "try", "throw": "throw"
}

keyword_kind(text) => KEYWORDS.get(text)

decode_escape(ch) {
    if ch == "n" { return "\n" }
    if ch == "r" { return "\r" }
    if ch == "t" { return "\t" }
    if ch == "0" { return "\0" }
    if ch == "\\" { return "\\" }
    if ch == "\"" { return "\"" }
    if ch == "$" { return "$" }
    ch
}

MULTI_CHAR_SYMBOLS = #{
    "...", "..=", "==", "!=", "<=", ">=", "&&", "||", "|>", "..", "?.", "?:",
    "=>", "->", "+=", "-=", "*=", "/=", "%="
}
SINGLE_CHAR_SYMBOLS = #{
    "=", "+", "-", "*", "/", "%", "<", ">", "!", ".", ",", ":", ";", "?", "|",
    "#", "(", ")", "{", "}", "[", "]"
}
WHITESPACE = #{" ", "\t", "\r"}

scan_number(input) {
    var text = input.take_while(|ch| ch.is_digit())
    next = input.peek()
    if input.current() == "." && next != null && next.is_digit() {
        text += input.take()
        text += input.take_while(|ch| ch.is_digit())
        return Token("float", text)
    }
    Token("int", text)
}

scan_string(input) {
    input.advance()
    var value = ""
    while !input.done() {
        ch = input.take()
        if ch == "\"" { return Token("string", value) }
        if ch == "\n" {
            assert(false, "unterminated string literal")
        }
        if ch == "\\" {
            assert(!input.done(), "unterminated string escape")
            value += decode_escape(input.take())
        } else {
            value += ch
        }
    }
    assert(false, "unterminated string literal")
    Token("string", value)
}

scan_identifier(input) {
    text = input.take_while(|ch| is_ident_continue(ch))
    keyword = keyword_kind(text)
    kind = keyword ?: if text.first().is_upper() { "data-ident" } else { "ident" }
    Token(kind, text)
}

scan_symbol(input) {
    symbol = input.match_longest(MULTI_CHAR_SYMBOLS)
    if symbol != null { return Token(symbol, symbol) }

    ch = input.take()
    assert(ch in SINGLE_CHAR_SYMBOLS, "unexpected character in source")
    Token(if ch == ";" { "sep" } else { ch }, ch)
}

next_token(input) => when ch = input.current() {
        _ if ch in WHITESPACE => {
            input.advance()
            null
        }
        "\n" => {
            input.advance()
            Token("sep", "\n")
        }
        "/" if input.starts_with("//") => {
            input.advance(2)
            input.skip_until(|value| value == "\n")
            null
        }
        _ if ch.is_digit() => scan_number(input)
        "\"" => scan_string(input)
        _ if is_ident_start(ch) => scan_identifier(input)
        else => scan_symbol(input)
    }

lex(source) {
    var result = []
    input = source.cursor()

    while !input.done() {
        token = next_token(input)
        if token != null { result.push(token) }
    }

    result.push(Token("eof", ""))
    result
}

quote(value) {
    var output = "\""
    for ch in value {
        if ch == "\n" {
            output = output + "\\n"
        } else if ch == "\r" {
            output = output + "\\r"
        } else if ch == "\t" {
            output = output + "\\t"
        } else if ch == "\0" {
            output = output + "\\0"
        } else if ch == "\"" {
            output = output + "\\\""
        } else if ch == "\\" {
            output = output + "\\\\"
        } else {
            output = output + ch
        }
    }
    return output + "\""
}


find_interpolation_end(value, index) {
    input = value.cursor()
    input.advance(index)
    var depth = 1
    var in_string = false
    var escaped = false

    while !input.done() {
        current_position = input.position()
        ch = input.take()

        if in_string {
            if escaped {
                escaped = false
            } else if ch == "\\" {
                escaped = true
            } else if ch == "\"" {
                in_string = false
            }
            continue
        }

        if ch == "\"" {
            in_string = true
        } else if ch == "{" {
            depth += 1
        } else if ch == "}" {
            depth -= 1
            if depth == 0 { return current_position }
        }
    }

    -1
}

compile_expression_fragment(source) {
    old_tokens = parse_tokens
    old_cursor = parse_cursor
    parse_tokens = lex(source)
    parse_cursor = 0
    expr = parse_expression()
    consume_separators()
    expect("eof")
    parse_tokens = old_tokens
    parse_cursor = old_cursor
    expr
}

combine_interpolation_parts(parts, index, output) {
    if index >= len(parts) { return output }
    combine_interpolation_parts(parts, index + 1, binary(output, "add", parts[index]))
}

interpolate_string(value) {
    var parts = []
    var literal = ""
    var index = 0
    length = len(value)

    while index < length {
        ch = value[index]
        next = value.get(index + 1) ?: ""

        if ch == "$" && next == "$" {
            literal += "$"
            index += 2
        } else if ch == "$" && next == "{" {
            if literal != "" {
                parts.push("(string " + quote(literal) + ")")
                literal = ""
            }
            end = find_interpolation_end(value, index + 2)
            assert(end >= 0, "unterminated string interpolation")
            fragment = value[index + 2..end]
            assert(trim(fragment) != "", "string interpolation cannot be empty")
            expr = compile_expression_fragment(fragment)
            parts.push("(call (ident \"string\") (args " + expr + "))")
            index = end + 1
        } else {
            literal += ch
            index += 1
        }
    }

    if literal != "" || len(parts) == 0 { parts.push("(string " + quote(literal) + ")") }
    combine_interpolation_parts(parts, 1, parts[0])
}

current_kind() {
    if parse_cursor >= len(parse_tokens) { return "eof" }
    return parse_tokens[parse_cursor].kind
}

current_text() {
    if parse_cursor >= len(parse_tokens) { return "" }
    return parse_tokens[parse_cursor].text
}

kind_at(index) {
    if index < 0 || index >= len(parse_tokens) { return "eof" }
    return parse_tokens[index].kind
}

at(kind) => current_kind() == kind

eat(kind) {
    if at(kind) {
        parse_cursor = parse_cursor + 1
        return true
    }
    return false
}

expect(kind) {
    assert(at(kind), "unexpected token")
    text = current_text()
    parse_cursor = parse_cursor + 1
    return text
}

consume_separators() {
    if at("sep") {
        parse_cursor = parse_cursor + 1
        return consume_separators()
    }
    return null
}

take_name() {
    assert(at("ident") || at("data-ident"), "expected name")
    text = current_text()
    parse_cursor = parse_cursor + 1
    return text
}

matching_paren_from(index, depth) {
    if index >= len(parse_tokens) { return -1 }
    kind = kind_at(index)
    if kind == "(" { return matching_paren_from(index + 1, depth + 1) }
    if kind == ")" {
        next_depth = depth - 1
        if next_depth == 0 { return index }
        return matching_paren_from(index + 1, next_depth)
    }
    return matching_paren_from(index + 1, depth)
}

matching_paren(start) => matching_paren_from(start, 0)

looks_like_function_decl() {
    if !at("ident") || kind_at(parse_cursor + 1) != "(" { return false }
    close = matching_paren(parse_cursor + 1)
    if close < 0 { return false }
    next = kind_at(close + 1)
    return next == "=>" || next == "{"
}

looks_like_data_decl() {
    if !at("data-ident") || kind_at(parse_cursor + 1) != "(" { return false }
    close = matching_paren(parse_cursor + 1)
    if close < 0 { return false }
    return kind_at(close + 1) == "{"
}

optional_string(value) {
    if value == null { return "(none)" }
    return "(some " + quote(value) + ")"
}

parse_type_name() {
    name = take_name()
    if eat("?") { return name + "?" }
    return name
}

parse_params_tail(output) {
    if at(")") { return output }
    name = take_name()
    var type_name = null
    if eat(":") { type_name = parse_type_name() }
    next_output = output + " (param " + quote(name) + " " + optional_string(type_name) + ")"
    consume_separators()
    if eat(",") {
        consume_separators()
        return parse_params_tail(next_output)
    }
    return next_output
}

parse_params() {
    expect("(")
    consume_separators()
    output = parse_params_tail("(params")
    expect(")")
    return output + ")"
}

parse_program() {
    consume_separators()
    var output = "(program"
    while !at("eof") {
        output += " " + parse_statement()
        if !at("eof") { consume_separators() }
    }
    expect("eof")
    output + ")"
}

parse_statement() {
    if eat("pub") { return "(pub " + parse_statement() + ")" }
    if eat("use") { return parse_use() }
    if eat("var") { return parse_var() }
    if eat("return") { return parse_return() }
    if eat("require") { return parse_require() }
    if eat("while") { return parse_while() }
    if eat("break") { return "(break)" }
    if eat("continue") { return "(continue)" }
    if eat("for") { return parse_for() }
    if eat("enum") { return parse_enum() }
    if at("if") { return "(expr " + parse_if() + ")" }
    if at("when") { return "(expr " + parse_when() + ")" }
    if looks_like_data_decl() { return parse_data() }
    if looks_like_function_decl() { return parse_function() }

    target = parse_expression()
    if eat("=") {
        value = parse_expression()
        return "(assign " + target + " " + value + ")"
    }

    var op = null
    if eat("+=") { op = "add" }
    else if eat("-=") { op = "subtract" }
    else if eat("*=") { op = "multiply" }
    else if eat("/=") { op = "divide" }
    else if eat("%=") { op = "remainder" }

    if op != null {
        assert(len(target) >= 7 && target[0..7] == "(ident ", "compound assignment currently requires an identifier target")
        value = parse_expression()
        return "(assign " + target + " " + binary(target, op, value) + ")"
    }

    return "(expr " + target + ")"
}

parse_use_tail(output) {
    if eat(".") { return parse_use_tail(output + " " + quote(take_name())) }
    return output
}

parse_use() => parse_use_tail("(use " + quote(take_name())) + ")"

parse_var() {
    name = take_name()
    var type_name = null
    if eat(":") { type_name = parse_type_name() }
    expect("=")
    value = parse_expression()
    return "(var " + quote(name) + " " + optional_string(type_name) + " " + value + ")"
}

parse_return() {
    if at("sep") || at("}") || at("eof") { return "(return (none))" }
    return "(return (some " + parse_expression() + "))"
}

parse_require() {
    condition = parse_expression()
    args = "(args " + condition
    if eat(",") { args = args + " " + parse_expression() }
    return "(expr (call (ident \"assert\") " + args + ")))"
}

prepend_block_statement(body, statement) => "(block " + statement + body[6..len(body)]

parse_while() {
    condition = parse_expression()
    body = parse_block()
    return "(while " + condition + " " + body + ")"
}

parse_for() {
    pattern = parse_postfix()
    expect("in")
    iterable = parse_expression()
    parsed_body = parse_block()
    binding = "(assign " + pattern + " (ident \"$item\"))"
    body = prepend_block_statement(parsed_body, binding)
    return "(for \"$item\" " + iterable + " " + body + ")"
}


parse_enum() {
    name = expect("data-ident")
    expect("{")
    consume_separators()
    var output = "(enum " + quote(name) + " (variants"
    while !at("}") {
        variant = expect("data-ident")
        params = if at("(") { parse_params() } else { "(params)" }
        output += " (variant " + quote(variant) + " " + params + ")"
        if eat(",") { consume_separators() }
        else if !at("}") { consume_separators() }
    }
    expect("}")
    output + "))"
}

parse_function() {
    name = expect("ident")
    params = parse_params()
    if eat("=>") {
        return "(function " + quote(name) + " " + params + " (body-expr " + parse_expression() + "))"
    }
    return "(function " + quote(name) + " " + params + " (body-block " + parse_block() + "))"
}

parse_data_fields(computed) {
    if at("}") { return computed }
    field = take_name()
    assert(eat("=") || eat("=>"), "expected computed field")
    next_computed = computed + " (field " + quote(field) + " " + parse_expression() + ")"
    if !at("}") { consume_separators() }
    return parse_data_fields(next_computed)
}

parse_data() {
    name = expect("data-ident")
    params = parse_params()
    expect("{")
    consume_separators()
    computed = parse_data_fields("(computed")
    expect("}")
    return "(data " + quote(name) + " " + params + " " + computed + "))"
}

parse_block_tail(output) {
    if at("}") { return output }
    next_output = output + " " + parse_statement()
    if !at("}") { consume_separators() }
    return parse_block_tail(next_output)
}

parse_block() {
    expect("{")
    consume_separators()
    output = parse_block_tail("(block")
    expect("}")
    return output + ")"
}

parse_if() {
    expect("if")
    condition = parse_expression()
    then_branch = parse_block()
    consume_separators()
    var else_branch = "(none)"
    if eat("else") {
        if at("if") {
            else_branch = "(else-if " + parse_if() + ")"
        } else {
            else_branch = "(else-block " + parse_block() + ")"
        }
    }
    return "(if " + condition + " " + then_branch + " " + else_branch + ")"
}

parse_when_patterns(output) {
    next_output = output + " " + parse_expression()
    if eat(",") {
        consume_separators()
        return parse_when_patterns(next_output)
    }
    return next_output + ")"
}

parse_when_body() {
    if at("{") { return "(when-block " + parse_block() + ")" }
    return "(when-expr " + parse_expression() + ")"
}

parse_when_case() {
    if eat("else") {
        expect("=>")
        return "(case (patterns) (none) " + parse_when_body() + " true)"
    }
    patterns = parse_when_patterns("(patterns")
    var guard = "(none)"
    if eat("if") { guard = "(some " + parse_expression() + ")" }
    expect("=>")
    return "(case " + patterns + " " + guard + " " + parse_when_body() + " false)"
}

parse_when_cases(output) {
    if at("}") { return output + ")" }
    next_output = output + " " + parse_when_case()
    if !at("}") { consume_separators() }
    return parse_when_cases(next_output)
}

parse_when() {
    expect("when")
    var binding = null
    var subject = "(none)"
    if !at("{") {
        if at("ident") && kind_at(parse_cursor + 1) == "=" {
            binding = expect("ident")
            expect("=")
        }
        subject = "(some " + parse_expression() + ")"
    }
    expect("{")
    consume_separators()
    cases = parse_when_cases("(cases")
    expect("}")
    return "(when " + optional_string(binding) + " " + subject + " " + cases + ")"
}

binary(left, op, right) => "(binary " + op + " " + left + " " + right + ")"

parse_expression() => parse_pipeline()

parse_pipeline_tail(expr) {
    if eat("|>") {
        callee = parse_elvis()
        return parse_pipeline_tail("(call " + callee + " (args " + expr + "))")
    }
    return expr
}

parse_pipeline() => parse_pipeline_tail(parse_elvis())

parse_elvis_tail(expr) {
    if eat("?:") { return parse_elvis_tail(binary(expr, "elvis", parse_or())) }
    return expr
}

parse_elvis() => parse_elvis_tail(parse_or())

parse_or_tail(expr) {
    if eat("||") { return parse_or_tail(binary(expr, "or", parse_and())) }
    return expr
}

parse_or() => parse_or_tail(parse_and())

parse_and_tail(expr) {
    if eat("&&") { return parse_and_tail(binary(expr, "and", parse_equality())) }
    return expr
}

parse_and() => parse_and_tail(parse_equality())

parse_equality_tail(expr) {
    if eat("==") { return parse_equality_tail(binary(expr, "equal", parse_comparison())) }
    if eat("!=") { return parse_equality_tail(binary(expr, "not-equal", parse_comparison())) }
    return expr
}

parse_equality() => parse_equality_tail(parse_comparison())

parse_range() {
    start = parse_additive()
    if eat("..") {
        end = parse_additive()
        assert(!at("..") && !at("..="), "range operators cannot be chained")
        return "(call (ident \"range\") (args " + start + " " + end + "))"
    }
    if eat("..=") {
        end = parse_additive()
        assert(!at("..") && !at("..="), "range operators cannot be chained")
        return "(call (ident \"range_inclusive\") (args " + start + " " + end + "))"
    }
    return start
}

parse_comparison_tail(expr) {
    if eat("in") {
        right = parse_range()
        return parse_comparison_tail("(call (ident \"contains\") (args " + right + " " + expr + "))")
    }
    if eat("<") { return parse_comparison_tail(binary(expr, "less", parse_range())) }
    if eat("<=") { return parse_comparison_tail(binary(expr, "less-equal", parse_range())) }
    if eat(">") { return parse_comparison_tail(binary(expr, "greater", parse_range())) }
    if eat(">=") { return parse_comparison_tail(binary(expr, "greater-equal", parse_range())) }
    return expr
}

parse_comparison() => parse_comparison_tail(parse_range())

parse_additive_tail(expr) {
    if eat("+") { return parse_additive_tail(binary(expr, "add", parse_multiplicative())) }
    if eat("-") { return parse_additive_tail(binary(expr, "subtract", parse_multiplicative())) }
    return expr
}

parse_additive() => parse_additive_tail(parse_multiplicative())

parse_multiplicative_tail(expr) {
    if eat("*") { return parse_multiplicative_tail(binary(expr, "multiply", parse_unary())) }
    if eat("/") { return parse_multiplicative_tail(binary(expr, "divide", parse_unary())) }
    if eat("%") { return parse_multiplicative_tail(binary(expr, "remainder", parse_unary())) }
    return expr
}

parse_multiplicative() => parse_multiplicative_tail(parse_unary())

parse_unary() {
    if eat("-") { return "(unary negate " + parse_unary() + ")" }
    if eat("!") { return "(unary not " + parse_unary() + ")" }
    return parse_postfix()
}

parse_args_tail(args) {
    if at(")") { return args }
    next_args = args + " " + parse_expression()
    consume_separators()
    if eat(",") {
        consume_separators()
        return parse_args_tail(next_args)
    }
    return next_args
}

index_range_kind(start) {
    var index = start
    var depth = 0
    while index < len(parse_tokens) {
        kind = kind_at(index)
        if kind == "(" || kind == "[" || kind == "{" {
            depth += 1
        } else if kind == "]" {
            if depth == 0 { return null }
            depth -= 1
        } else if kind == ")" || kind == "}" {
            if depth > 0 { depth -= 1 }
        } else if depth == 0 && (kind == ".." || kind == "..=") {
            return kind
        }
        index += 1
    }
    null
}

parse_postfix_tail(expr) {
    if eat("(") {
        consume_separators()
        args = parse_args_tail("(args")
        expect(")")
        return parse_postfix_tail("(call " + expr + " " + args + "))")
    }
    if eat(".") {
        return parse_postfix_tail("(member " + expr + " " + quote(take_name()) + " false)")
    }
    if eat("?.") {
        return parse_postfix_tail("(member " + expr + " " + quote(take_name()) + " true)")
    }
    if eat("[") {
        range_kind = index_range_kind(parse_cursor)
        if range_kind != null {
            start = parse_additive()
            inclusive = eat("..=")
            if !inclusive { expect("..") }
            end = parse_additive()
            expect("]")
            callee = if inclusive { "slice_inclusive" } else { "slice" }
            return parse_postfix_tail("(call (ident \"" + callee + "\") (args " + expr + " " + start + " " + end + "))")
        }
        index = parse_expression()
        expect("]")
        return parse_postfix_tail("(index " + expr + " " + index + ")")
    }
    if eat("?") { return parse_postfix_tail("(propagate " + expr + ")") }
    return expr
}

parse_postfix() => parse_postfix_tail(parse_primary())

parse_list_tail(output) {
    if at("]") { return output }
    if eat("...") {
        name = expect("ident")
        if eat(",") { consume_separators() }
        assert(at("]"), "rest pattern must be final")
        return output + " (rest " + quote(name) + ")"
    }
    next_output = output + " " + parse_expression()
    consume_separators()
    if eat(",") {
        consume_separators()
        return parse_list_tail(next_output)
    }
    return next_output
}



parse_map_entries(output) {
    if at("}") { return output }
    key = parse_expression()
    expect(":")
    value = parse_expression()
    next_output = output + " (entry " + key + " " + value + ")"
    consume_separators()
    if eat(",") {
        consume_separators()
        return parse_map_entries(next_output)
    }
    return next_output
}

parse_map() {
    consume_separators()
    output = parse_map_entries("(map")
    expect("}")
    output + ")"
}

parse_set_tail(output) {
    if at("}") { return output }
    next_output = output + " " + parse_expression()
    consume_separators()
    if eat(",") {
        consume_separators()
        return parse_set_tail(next_output)
    }
    return next_output
}

parse_set() {
    expect("{")
    consume_separators()
    output = parse_set_tail("(set")
    expect("}")
    output + ")"
}

parse_lambda_params(output) {
    name = take_name()
    next_output = output + " (param " + quote(name) + " (none))"
    consume_separators()
    if eat(",") {
        consume_separators()
        return parse_lambda_params(next_output)
    }
    return next_output + ")"
}

parse_lambda() {
    consume_separators()
    params = parse_lambda_params("(params")
    expect("|")
    return "(lambda " + params + " " + parse_expression() + ")"
}

parse_primary() {
    if at("int") {
        value = current_text()
        parse_cursor = parse_cursor + 1
        return "(int " + value + ")"
    }
    if at("float") {
        value = current_text()
        parse_cursor = parse_cursor + 1
        return "(float " + value + ")"
    }
    if at("string") {
        value = current_text()
        parse_cursor = parse_cursor + 1
        return interpolate_string(value)
    }
    if eat("true") { return "(bool true)" }
    if eat("false") { return "(bool false)" }
    if eat("null") { return "null" }
    if eat("|") { return parse_lambda() }
    if at("ident") || at("data-ident") {
        name = take_name()
        return "(ident " + quote(name) + ")"
    }
    if eat("(") {
        expr = parse_expression()
        expect(")")
        return expr
    }
    if eat("[") {
        consume_separators()
        output = parse_list_tail("(list")
        expect("]")
        return output + ")"
    }
    if eat("{") { return parse_map() }
    if eat("#") { return parse_set() }
    if at("if") { return parse_if() }
    if at("when") { return parse_when() }
    assert(false, "expected expression")
    return "null"
}

compile(source) {
    parse_tokens = lex(source)
    parse_cursor = 0
    return "VELRA-AST-1\n" + parse_program()
}
