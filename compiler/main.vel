Token(kind, text) {}

var parse_tokens = []
var parse_cursor = 0

is_ident_start(ch) => ch == "_" || ch.is_letter()
is_ident_continue(ch) => ch == "_" || ch.is_alphanumeric()

KEYWORDS = {
    "true": "true", "false": "false", "null": "null", "use": "use", "pub": "pub",
    "var": "var", "if": "if", "else": "else", "for": "for", "while": "while",
    "break": "break", "continue": "continue", "in": "in", "when": "when",
    "return": "return", "require": "require", "enum": "enum", "object": "object",
    "extend": "extend", "shape": "shape", "async": "async", "await": "await",
    "try": "try", "throw": "throw"
}

keyword_kind(text) => KEYWORDS.get(text)

decode_escape(ch) {
    if ch == "n" { return "\n" }
    if ch == "r" { return "\r" }
    if ch == "t" { return "\t" }
    if ch == "0" { return "\0" }
    if ch == "\\" { return "\\" }
    if ch == "\"" { return "\"" }
    if ch == "$" { return "$" }
    ch
}

MULTI_CHAR_SYMBOLS = #{
    "...", "..=", "==", "!=", "<=", ">=", "&&", "||", "|>", "..", "?.", "?:",
    "=>", "->", "+=", "-=", "*=", "/=", "%="
}
SINGLE_CHAR_SYMBOLS = #{
    "=", "+", "-", "*", "/", "%", "<", ">", "!", ".", ",", ":", ";", "?", "|",
    "#", "(", ")", "{", "}", "[", "]"
}
WHITESPACE = #{" ", "\t", "\r"}

scan_number(input) {
    var text = input.take_while(|ch| ch.is_digit())
    next = input.peek()
    if input.current() == "." && next != null && next.is_digit() {
        text += input.take()
        text += input.take_while(|ch| ch.is_digit())
        return Token("float", text)
    }
    Token("int", text)
}

scan_string(input) {
    input.advance()
    var value = ""
    while !input.done() {
        ch = input.take()
        if ch == "\"" { return Token("string", value) }
        if ch == "\n" {
            assert(false, "unterminated string literal")
        }
        if ch == "\\" {
            assert(!input.done(), "unterminated string escape")
            value += decode_escape(input.take())
        } else {
            value += ch
        }
    }
    assert(false, "unterminated string literal")
    Token("string", value)
}

scan_identifier(input) {
    text = input.take_while(|ch| is_ident_continue(ch))
    keyword = keyword_kind(text)
    kind = keyword ?: if text.first().is_upper() { "data-ident" } else { "ident" }
    Token(kind, text)
}

scan_symbol(input) {
    symbol = input.match_longest(MULTI_CHAR_SYMBOLS)
    if symbol != null { return Token(symbol, symbol) }

    ch = input.take()
    assert(ch in SINGLE_CHAR_SYMBOLS, "unexpected character in source")
    Token(if ch == ";" { "sep" } else { ch }, ch)
}

next_token(input) => when ch = input.current() {
        _ if ch in WHITESPACE => {
            input.skip_while(|value| value in WHITESPACE)
            null
        }
        "\n" => {
            input.advance()
            Token("sep", "\n")
        }
        "/" if input.starts_with("//") => {
            input.advance(2)
            input.skip_until(|value| value == "\n")
            null
        }
        _ if ch.is_digit() => scan_number(input)
        "\"" => scan_string(input)
        _ if is_ident_start(ch) => scan_identifier(input)
        else => scan_symbol(input)
    }

lex(source) {
    var result = []
    input = source.cursor()

    while !input.done() {
        token = next_token(input)
        if token != null { result.push(token) }
    }

    result.push(Token("eof", ""))
    result
}

quote(value) {
    var output = "\""
    for ch in value {
        if ch == "\n" {
            output = output + "\\n"
        } else if ch == "\r" {
            output = output + "\\r"
        } else if ch == "\t" {
            output = output + "\\t"
        } else if ch == "\0" {
            output = output + "\\0"
        } else if ch == "\"" {
            output = output + "\\\""
        } else if ch == "\\" {
            output = output + "\\\\"
        } else {
            output = output + ch
        }
    }
    return output + "\""
}


find_interpolation_end(value, index) {
    input = value.cursor()
    input.advance(index)
    var depth = 1
    var in_string = false
    var escaped = false

    while !input.done() {
        current_position = input.position()
        ch = input.take()

        if in_string {
            if escaped {
                escaped = false
            } else if ch == "\\" {
                escaped = true
            } else if ch == "\"" {
                in_string = false
            }
            continue
        }

        if ch == "\"" {
            in_string = true
        } else if ch == "{" {
            depth += 1
        } else if ch == "}" {
            depth -= 1
            if depth == 0 { return current_position }
        }
    }

    -1
}

compile_expression_fragment(source) {
    old_tokens = parse_tokens
    old_cursor = parse_cursor
    parse_tokens = lex(source)
    parse_cursor = 0
    expr = parse_expression()
    consume_separators()
    expect("eof")
    parse_tokens = old_tokens
    parse_cursor = old_cursor
    expr
}

interpolate_string(value) {
    var parts = []
    var literal = ""
    var index = 0
    length = len(value)

    while index < length {
        ch = value[index]
        next = value.get(index + 1) ?: ""

        if ch == "$" && next == "$" {
            literal += "$"
            index += 2
        } else if ch == "$" && next == "{" {
            if literal != "" {
                parts.push("(string " + quote(literal) + ")")
                literal = ""
            }
            end = find_interpolation_end(value, index + 2)
            assert(end >= 0, "unterminated string interpolation")
            fragment = value[index + 2..end]
            assert(trim(fragment) != "", "string interpolation cannot be empty")
            expr = compile_expression_fragment(fragment)
            parts.push("(call (ident \"string\") (args " + expr + "))")
            index = end + 1
        } else {
            literal += ch
            index += 1
        }
    }

    if literal != "" || len(parts) == 0 { parts.push("(string " + quote(literal) + ")") }
    var output = parts[0]
    var part_index = 1
    while part_index < len(parts) {
        output = binary(output, "add", parts[part_index])
        part_index += 1
    }
    output
}

current_text() => parse_tokens[parse_cursor].text

kind_at(index) {
    if index < 0 || index >= len(parse_tokens) { return "eof" }
    return parse_tokens[index].kind
}

at(kind) => parse_tokens[parse_cursor].kind == kind

eat(kind) {
    if at(kind) {
        parse_cursor = parse_cursor + 1
        return true
    }
    return false
}

expect(kind) {
    token = parse_tokens[parse_cursor]
    assert(token.kind == kind, "unexpected token")
    parse_cursor = parse_cursor + 1
    return token.text
}

consume_separators() {
    while at("sep") {
        parse_cursor = parse_cursor + 1
    }
    null
}

take_name() {
    token = parse_tokens[parse_cursor]
    assert(token.kind == "ident" || token.kind == "data-ident", "expected name")
    parse_cursor = parse_cursor + 1
    return token.text
}

matching_paren(start) {
    var index = start
    var depth = 0
    while index < len(parse_tokens) {
        kind = kind_at(index)
        if kind == "(" {
            depth += 1
        } else if kind == ")" {
            depth -= 1
            if depth == 0 { return index }
        }
        index += 1
    }
    -1
}

looks_like_function_decl() {
    if !at("ident") || kind_at(parse_cursor + 1) != "(" { return false }
    close = matching_paren(parse_cursor + 1)
    if close < 0 { return false }
    next = kind_at(close + 1)
    return next == "=>" || next == "{"
}

looks_like_data_decl() {
    if !at("data-ident") || kind_at(parse_cursor + 1) != "(" { return false }
    close = matching_paren(parse_cursor + 1)
    if close < 0 { return false }
    return kind_at(close + 1) == "{"
}

optional_string(value) {
    if value == null { return "(none)" }
    return "(some " + quote(value) + ")"
}

parse_type_name() {
    name = take_name()
    if eat("?") { return name + "?" }
    return name
}

parse_params() {
    expect("(")
    consume_separators()
    var output = "(params"
    while !at(")") {
        name = take_name()
        var type_name = null
        if eat(":") { type_name = parse_type_name() }
        output += " (param " + quote(name) + " " + optional_string(type_name) + ")"
        consume_separators()
        if !eat(",") { break }
        consume_separators()
    }
    expect(")")
    output + ")"
}

parse_program() {
    consume_separators()
    var output = "(program"
    while !at("eof") {
        output += " " + parse_statement()
        if !at("eof") { consume_separators() }
    }
    expect("eof")
    output + ")"
}

parse_statement() {
    kind = parse_tokens[parse_cursor].kind
    if kind == "pub" {
        parse_cursor += 1
        return "(pub " + parse_statement() + ")"
    }
    if kind == "use" {
        parse_cursor += 1
        return parse_use()
    }
    if kind == "var" {
        parse_cursor += 1
        return parse_var()
    }
    if kind == "return" {
        parse_cursor += 1
        return parse_return()
    }
    if kind == "require" {
        parse_cursor += 1
        return parse_require()
    }
    if kind == "while" {
        parse_cursor += 1
        return parse_while()
    }
    if kind == "break" {
        parse_cursor += 1
        return "(break)"
    }
    if kind == "continue" {
        parse_cursor += 1
        return "(continue)"
    }
    if kind == "for" {
        parse_cursor += 1
        return parse_for()
    }
    if kind == "enum" {
        parse_cursor += 1
        return parse_enum()
    }
    if kind == "if" { return "(expr " + parse_if() + ")" }
    if kind == "when" { return "(expr " + parse_when() + ")" }
    if kind == "data-ident" && looks_like_data_decl() { return parse_data() }
    if kind == "ident" && looks_like_function_decl() { return parse_function() }

    target = parse_expression()
    assignment_kind = parse_tokens[parse_cursor].kind
    if assignment_kind == "=" {
        parse_cursor += 1
        value = parse_expression()
        return "(assign " + target + " " + value + ")"
    }

    var op = null
    if assignment_kind == "+=" { op = "add" }
    else if assignment_kind == "-=" { op = "subtract" }
    else if assignment_kind == "*=" { op = "multiply" }
    else if assignment_kind == "/=" { op = "divide" }
    else if assignment_kind == "%=" { op = "remainder" }

    if op != null {
        parse_cursor += 1
        assert(len(target) >= 7 && target[0..7] == "(ident ", "compound assignment currently requires an identifier target")
        value = parse_expression()
        return "(assign " + target + " " + binary(target, op, value) + ")"
    }

    return "(expr " + target + ")"
}

parse_use() {
    var output = "(use " + quote(take_name())
    while eat(".") { output += " " + quote(take_name()) }
    output + ")"
}

parse_var() {
    name = take_name()
    var type_name = null
    if eat(":") { type_name = parse_type_name() }
    expect("=")
    value = parse_expression()
    return "(var " + quote(name) + " " + optional_string(type_name) + " " + value + ")"
}

parse_return() {
    if at("sep") || at("}") || at("eof") { return "(return (none))" }
    return "(return (some " + parse_expression() + "))"
}

parse_require() {
    condition = parse_expression()
    args = "(args " + condition
    if eat(",") { args = args + " " + parse_expression() }
    return "(expr (call (ident \"assert\") " + args + ")))"
}

prepend_block_statement(body, statement) => "(block " + statement + body[6..len(body)]

parse_while() {
    condition = parse_expression()
    body = parse_block()
    return "(while " + condition + " " + body + ")"
}

parse_for() {
    pattern = parse_postfix()
    expect("in")
    iterable = parse_expression()
    parsed_body = parse_block()
    binding = "(assign " + pattern + " (ident \"$item\"))"
    body = prepend_block_statement(parsed_body, binding)
    return "(for \"$item\" " + iterable + " " + body + ")"
}


parse_enum() {
    name = expect("data-ident")
    expect("{")
    consume_separators()
    var output = "(enum " + quote(name) + " (variants"
    while !at("}") {
        variant = expect("data-ident")
        params = if at("(") { parse_params() } else { "(params)" }
        output += " (variant " + quote(variant) + " " + params + ")"
        if eat(",") { consume_separators() }
        else if !at("}") { consume_separators() }
    }
    expect("}")
    output + "))"
}

parse_function() {
    name = expect("ident")
    params = parse_params()
    if eat("=>") {
        return "(function " + quote(name) + " " + params + " (body-expr " + parse_expression() + "))"
    }
    return "(function " + quote(name) + " " + params + " (body-block " + parse_block() + "))"
}

parse_data() {
    name = expect("data-ident")
    params = parse_params()
    expect("{")
    consume_separators()
    var computed = "(computed"
    while !at("}") {
        field = take_name()
        assert(eat("=") || eat("=>"), "expected computed field")
        computed += " (field " + quote(field) + " " + parse_expression() + ")"
        if !at("}") { consume_separators() }
    }
    expect("}")
    return "(data " + quote(name) + " " + params + " " + computed + "))"
}

parse_block() {
    expect("{")
    consume_separators()
    var output = "(block"
    while !at("}") {
        output += " " + parse_statement()
        if !at("}") { consume_separators() }
    }
    expect("}")
    output + ")"
}

parse_if() {
    expect("if")
    condition = parse_expression()
    then_branch = parse_block()
    consume_separators()
    var else_branch = "(none)"
    if eat("else") {
        if at("if") {
            else_branch = "(else-if " + parse_if() + ")"
        } else {
            else_branch = "(else-block " + parse_block() + ")"
        }
    }
    return "(if " + condition + " " + then_branch + " " + else_branch + ")"
}

parse_when_patterns() {
    var output = "(patterns"
    while true {
        output += " " + parse_expression()
        if !eat(",") { break }
        consume_separators()
    }
    output + ")"
}

parse_when_body() {
    if at("{") { return "(when-block " + parse_block() + ")" }
    return "(when-expr " + parse_expression() + ")"
}

parse_when_case() {
    if eat("else") {
        expect("=>")
        return "(case (patterns) (none) " + parse_when_body() + " true)"
    }
    patterns = parse_when_patterns()
    var guard = "(none)"
    if eat("if") { guard = "(some " + parse_expression() + ")" }
    expect("=>")
    return "(case " + patterns + " " + guard + " " + parse_when_body() + " false)"
}

parse_when() {
    expect("when")
    var binding = null
    var subject = "(none)"
    if !at("{") {
        if at("ident") && kind_at(parse_cursor + 1) == "=" {
            binding = expect("ident")
            expect("=")
        }
        subject = "(some " + parse_expression() + ")"
    }
    expect("{")
    consume_separators()
    var cases = "(cases"
    while !at("}") {
        cases += " " + parse_when_case()
        if !at("}") { consume_separators() }
    }
    expect("}")
    return "(when " + optional_string(binding) + " " + subject + " " + cases + "))"
}

binary(left, op, right) => "(binary " + op + " " + left + " " + right + ")"

parse_expression() => parse_pipeline()

parse_pipeline() {
    var expr = parse_elvis()
    while parse_tokens[parse_cursor].kind == "|>" {
        parse_cursor += 1
        callee = parse_elvis()
        expr = "(call " + callee + " (args " + expr + "))"
    }
    expr
}

parse_elvis() {
    var expr = parse_or()
    while parse_tokens[parse_cursor].kind == "?:" {
        parse_cursor += 1
        expr = binary(expr, "elvis", parse_or())
    }
    expr
}

parse_or() {
    var expr = parse_and()
    while parse_tokens[parse_cursor].kind == "||" {
        parse_cursor += 1
        expr = binary(expr, "or", parse_and())
    }
    expr
}

parse_and() {
    var expr = parse_equality()
    while parse_tokens[parse_cursor].kind == "&&" {
        parse_cursor += 1
        expr = binary(expr, "and", parse_equality())
    }
    expr
}

parse_equality() {
    var expr = parse_comparison()
    while true {
        kind = parse_tokens[parse_cursor].kind
        if kind != "==" && kind != "!=" { return expr }
        parse_cursor += 1
        op = if kind == "==" { "equal" } else { "not-equal" }
        expr = binary(expr, op, parse_comparison())
    }
}

parse_range() {
    start = parse_additive()
    if eat("..") {
        end = parse_additive()
        assert(!at("..") && !at("..="), "range operators cannot be chained")
        return "(call (ident \"range\") (args " + start + " " + end + "))"
    }
    if eat("..=") {
        end = parse_additive()
        assert(!at("..") && !at("..="), "range operators cannot be chained")
        return "(call (ident \"range_inclusive\") (args " + start + " " + end + "))"
    }
    return start
}

parse_comparison() {
    var expr = parse_range()
    while true {
        kind = parse_tokens[parse_cursor].kind
        if kind == "in" {
            parse_cursor += 1
            right = parse_range()
            expr = "(call (ident \"contains\") (args " + right + " " + expr + "))"
            continue
        }
        if kind != "<" && kind != "<=" && kind != ">" && kind != ">=" { return expr }
        parse_cursor += 1
        op = if kind == "<" { "less" }
            else if kind == "<=" { "less-equal" }
            else if kind == ">" { "greater" }
            else { "greater-equal" }
        expr = binary(expr, op, parse_range())
    }
}

parse_additive() {
    var expr = parse_multiplicative()
    while true {
        kind = parse_tokens[parse_cursor].kind
        if kind != "+" && kind != "-" { return expr }
        parse_cursor += 1
        op = if kind == "+" { "add" } else { "subtract" }
        expr = binary(expr, op, parse_multiplicative())
    }
}

parse_multiplicative() {
    var expr = parse_unary()
    while true {
        kind = parse_tokens[parse_cursor].kind
        if kind != "*" && kind != "/" && kind != "%" { return expr }
        parse_cursor += 1
        op = if kind == "*" { "multiply" }
            else if kind == "/" { "divide" }
            else { "remainder" }
        expr = binary(expr, op, parse_unary())
    }
}

parse_unary() {
    if eat("-") { return "(unary negate " + parse_unary() + ")" }
    if eat("!") { return "(unary not " + parse_unary() + ")" }
    return parse_postfix()
}

index_range_kind(start) {
    var index = start
    var depth = 0
    while index < len(parse_tokens) {
        kind = kind_at(index)
        if kind == "(" || kind == "[" || kind == "{" {
            depth += 1
        } else if kind == "]" {
            if depth == 0 { return null }
            depth -= 1
        } else if kind == ")" || kind == "}" {
            if depth > 0 { depth -= 1 }
        } else if depth == 0 && (kind == ".." || kind == "..=") {
            return kind
        }
        index += 1
    }
    null
}

parse_postfix() {
    var expr = parse_primary()
    while true {
        kind = parse_tokens[parse_cursor].kind
        if kind == "(" {
            parse_cursor += 1
            consume_separators()
            var args = "(args"
            while !at(")") {
                args += " " + parse_expression()
                consume_separators()
                if !eat(",") { break }
                consume_separators()
            }
            expect(")")
            expr = "(call " + expr + " " + args + "))"
        } else if kind == "." {
            parse_cursor += 1
            expr = "(member " + expr + " " + quote(take_name()) + " false)"
        } else if kind == "?." {
            parse_cursor += 1
            expr = "(member " + expr + " " + quote(take_name()) + " true)"
        } else if kind == "[" {
            parse_cursor += 1
            range_kind = index_range_kind(parse_cursor)
            if range_kind != null {
                start = parse_additive()
                inclusive = eat("..=")
                if !inclusive { expect("..") }
                end = parse_additive()
                expect("]")
                callee = if inclusive { "slice_inclusive" } else { "slice" }
                expr = "(call (ident \"" + callee + "\") (args " + expr + " " + start + " " + end + "))"
            } else {
                index = parse_expression()
                expect("]")
                expr = "(index " + expr + " " + index + ")"
            }
        } else if kind == "?" {
            parse_cursor += 1
            expr = "(propagate " + expr + ")"
        } else {
            return expr
        }
    }
}

parse_map() {
    consume_separators()
    var output = "(map"
    while !at("}") {
        key = parse_expression()
        expect(":")
        value = parse_expression()
        output += " (entry " + key + " " + value + ")"
        consume_separators()
        if !eat(",") { break }
        consume_separators()
    }
    expect("}")
    output + ")"
}

parse_set() {
    expect("{")
    consume_separators()
    var output = "(set"
    while !at("}") {
        output += " " + parse_expression()
        consume_separators()
        if !eat(",") { break }
        consume_separators()
    }
    expect("}")
    output + ")"
}

parse_lambda() {
    consume_separators()
    var params = "(params"
    while true {
        name = take_name()
        params += " (param " + quote(name) + " (none))"
        consume_separators()
        if !eat(",") { break }
        consume_separators()
    }
    expect("|")
    return "(lambda " + params + ") " + parse_expression() + ")"
}

parse_primary() {
    token = parse_tokens[parse_cursor]
    kind = token.kind
    if kind == "int" {
        parse_cursor = parse_cursor + 1
        return "(int " + token.text + ")"
    }
    if kind == "float" {
        parse_cursor = parse_cursor + 1
        return "(float " + token.text + ")"
    }
    if kind == "string" {
        parse_cursor = parse_cursor + 1
        return interpolate_string(token.text)
    }
    if kind == "true" {
        parse_cursor += 1
        return "(bool true)"
    }
    if kind == "false" {
        parse_cursor += 1
        return "(bool false)"
    }
    if kind == "null" {
        parse_cursor += 1
        return "null"
    }
    if kind == "|" {
        parse_cursor += 1
        return parse_lambda()
    }
    if kind == "ident" || kind == "data-ident" {
        parse_cursor += 1
        return "(ident " + quote(token.text) + ")"
    }
    if kind == "(" {
        parse_cursor += 1
        expr = parse_expression()
        expect(")")
        return expr
    }
    if kind == "[" {
        parse_cursor += 1
        consume_separators()
        var output = "(list"
        while !at("]") {
            if eat("...") {
                name = expect("ident")
                if eat(",") { consume_separators() }
                assert(at("]"), "rest pattern must be final")
                output += " (rest " + quote(name) + ")"
                break
            }
            output += " " + parse_expression()
            consume_separators()
            if !eat(",") { break }
            consume_separators()
        }
        expect("]")
        return output + ")"
    }
    if kind == "{" {
        parse_cursor += 1
        return parse_map()
    }
    if kind == "#" {
        parse_cursor += 1
        return parse_set()
    }
    if kind == "if" { return parse_if() }
    if kind == "when" { return parse_when() }
    assert(false, "expected expression")
    return "null"
}

compile(source) {
    parse_tokens = lex(source)
    parse_cursor = 0
    return "VELRA-AST-1\n" + parse_program()
}
